# Used by Docker Compose / docker run --env-file. The Python CLI reads environment
# variables directly; it does not automatically load this file.
LLAMA_BACKENDS=http://host.docker.internal:8088/v1,http://host.docker.internal:8089/v1
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required for the container's 0.0.0.0 bind. Multiple keys may be comma-separated.
PROXY_API_KEYS=
# Set this only if your upstream servers require the same separate API key.
BACKEND_API_KEY=
PROXY_LOG_LEVEL=off
